# =========================================================
# VPN CONFIGURATION
# =========================================================

SERVER_IP = "192.168.100.1"
SERVER_PORT = 6000

TUN_NAME = "tun0"
TUN_IP = "10.8.0.2"
TUN_NETWORK = "10.8.0.0/24"

PROTOCOL_VERSION = b"QuantumSafeVPN-v1"


# ---------------------------------------------------------
# Trusted server identity
#
# SHA-256 fingerprint of:
# keys/server_mldsa65_public.key
# ---------------------------------------------------------

EXPECTED_SERVER_MLDSA_SHA256 = (
    "77497277cece090a1fc6054cb9f51a9fa7e4c9353a673dc133f675c22323a0dc"
)


# ---------------------------------------------------------
# Expected ML-DSA-65 sizes
# ---------------------------------------------------------

MLDSA_PUBLIC_KEY_SIZE = 1952
MLDSA_SIGNATURE_SIZE = 3309


# ---------------------------------------------------------
# Expected ML-KEM-1024 sizes
# ---------------------------------------------------------

MLKEM_PUBLIC_KEY_SIZE = 1568
MLKEM_CIPHERTEXT_SIZE = 1568


# =========================================================
# FRAMING FUNCTIONS
# =========================================================

def recv_exact(sock, size):

    data = b""

    while len(data) < size:

        chunk = sock.recv(
            size - len(data)
        )

        if not chunk:
            raise ConnectionError(
                "Connection closed"
            )

        data += chunk

    return data


def send_frame(sock, data):

    header = struct.pack(
        "!I",
        len(data)
    )

    sock.sendall(header)
    sock.sendall(data)


def recv_frame(sock):

    header = recv_exact(
        sock,
        4
    )

    length = struct.unpack(
        "!I",
        header
    )[0]

    if length <= 0 or length > 65535:

        raise ValueError(
            "Invalid packet length"
        )

    return recv_exact(
        sock,
        length
    )


# =========================================================
# SERVER IDENTITY PINNING
# =========================================================

def verify_server_identity(
    dsa_public_key
):

    print(
        "[*] Verifying pinned server identity..."
    )

    fingerprint = hashlib.sha256(
        dsa_public_key
    ).hexdigest()

    print(
        f"[*] Server ML-DSA-65 SHA-256:"
    )

    print(
        f"    {fingerprint}"
    )

    if fingerprint.lower() != (
        EXPECTED_SERVER_MLDSA_SHA256.lower()
    ):

        raise ValueError(
            "SERVER IDENTITY VERIFICATION FAILED"
        )

    print(
        "[+] Server identity verified"
    )


# =========================================================
# TUN → NETWORK
# =========================================================

def tun_to_network(
    tun,
    sock,
    session_key
):

    try:

        while True:

            packet = tun.read_packet()

            if not packet:
                continue

            encrypted_packet = encrypt(
                session_key,
                packet
            )

            send_frame(
                sock,
                encrypted_packet
            )

            print(
                f"[TUN → VPN] "
                f"{len(packet)} bytes "
                f"→ encrypted "
                f"{len(encrypted_packet)} bytes"
            )

    except Exception as e:

        print(
            f"[!] TUN → network stopped: {e}"
        )


# =========================================================
# NETWORK → TUN
# =========================================================

def network_to_tun(
    tun,
    sock,
    session_key
):

    try:

        while True:

            encrypted_packet = recv_frame(
                sock
            )

            packet = decrypt(
                session_key,
                encrypted_packet
            )

            tun.write_packet(
                packet
            )

            print(
                f"[VPN → TUN] "
                f"encrypted "
                f"{len(encrypted_packet)} bytes "
                f"→ decrypted "
                f"{len(packet)} bytes"
            )

    except Exception as e:

        print(
            f"[!] Network → TUN stopped: {e}"
        )


# =========================================================
# ML-KEM + ML-DSA HANDSHAKE
# =========================================================

def perform_handshake(sock):

    print()
    print("=" * 60)
    print("QUANTUM-SAFE VPN HANDSHAKE")
    print("=" * 60)

    # -----------------------------------------------------
    # 1. Receive server ML-DSA public key
    # -----------------------------------------------------

    print(
        "[*] Waiting for ML-DSA-65 server public key..."
    )

    dsa_public_key = recv_frame(
        sock
    )

    print(
        f"[+] ML-DSA public key received: "
        f"{len(dsa_public_key)} bytes"
    )

    # -----------------------------------------------------
    # 2. Check ML-DSA public key size
    # -----------------------------------------------------

    if len(dsa_public_key) != (
        MLDSA_PUBLIC_KEY_SIZE
    ):

        raise ValueError(
            "Invalid ML-DSA-65 public key size"
        )

    # -----------------------------------------------------
    # 3. Verify trusted server identity
    # -----------------------------------------------------

    verify_server_identity(
        dsa_public_key
    )

    # -----------------------------------------------------
    # 4. Generate ML-KEM-1024 client key pair
    # -----------------------------------------------------

    print(
        "[*] Generating ML-KEM-1024 key pair..."
    )

    kem_public_key, kem_secret_key = (
        generate_keypair()
    )

    print(
        f"[+] ML-KEM public key: "
        f"{len(kem_public_key)} bytes"
    )

    # -----------------------------------------------------
    # 5. Check ML-KEM public key size
    # -----------------------------------------------------

    if len(kem_public_key) != (
        MLKEM_PUBLIC_KEY_SIZE
    ):

        raise ValueError(
            "Invalid ML-KEM-1024 public key size"
        )

    # -----------------------------------------------------
    # 6. Send ML-KEM public key
    # -----------------------------------------------------

    send_frame(
        sock,
        kem_public_key
    )

    print(
        "[+] ML-KEM public key sent"
    )

    # -----------------------------------------------------
    # 7. Receive ML-KEM ciphertext
    # -----------------------------------------------------

    print(
        "[*] Waiting for ML-KEM-1024 ciphertext..."
    )

    ciphertext = recv_frame(
        sock
    )

    print(
        f"[+] ML-KEM ciphertext received: "
        f"{len(ciphertext)} bytes"
    )

    # -----------------------------------------------------
    # 8. Check ML-KEM ciphertext size
    # -----------------------------------------------------

    if len(ciphertext) != (
        MLKEM_CIPHERTEXT_SIZE
    ):

        raise ValueError(
            "Invalid ML-KEM-1024 ciphertext size"
        )

    # -----------------------------------------------------
    # 9. Receive ML-DSA signature
    # -----------------------------------------------------

    print(
        "[*] Waiting for ML-DSA-65 signature..."
    )

    signature = recv_frame(
        sock
    )

    print(
        f"[+] ML-DSA signature received: "
        f"{len(signature)} bytes"
    )

    # -----------------------------------------------------
    # 10. Check ML-DSA signature size
    # -----------------------------------------------------

    if len(signature) != (
        MLDSA_SIGNATURE_SIZE
    ):

        raise ValueError(
            "Invalid ML-DSA-65 signature size"
        )

    # -----------------------------------------------------
    # 11. Build handshake transcript
    #
    # MUST match the server.
    # -----------------------------------------------------

    transcript = (
        PROTOCOL_VERSION
        + kem_public_key
        + ciphertext
    )

    # -----------------------------------------------------
    # 12. Verify ML-DSA signature
    # -----------------------------------------------------

    print(
        "[*] Verifying ML-DSA-65 signature..."
    )

    valid = verify(
        dsa_public_key,
        transcript,
        signature
    )

    if not valid:

        raise ValueError(
            "ML-DSA-65 signature verification failed"
        )

    print(
        "[+] ML-DSA-65 signature verified"
    )

    # -----------------------------------------------------
    # 13. ML-KEM decapsulation
    # -----------------------------------------------------

    print(
        "[*] Decapsulating ML-KEM-1024 ciphertext..."
    )

    shared_secret = decapsulate(
        kem_secret_key,
        ciphertext
    )

    print(
        "[+] ML-KEM-1024 decapsulation successful"
    )

    print(
        f"[+] Shared secret size: "
        f"{len(shared_secret)} bytes"
    )

    # -----------------------------------------------------
    # 14. Derive AES-256 session key
    # -----------------------------------------------------

    session_key = derive_session_key(
        shared_secret
    )

    print(
        "[+] AES-256-GCM session key established"
    )

    print()
    print("=" * 60)
    print("QUANTUM-SAFE VPN HANDSHAKE COMPLETE")
    print("=" * 60)

    print(
        "Key Exchange     : ML-KEM-1024"
    )

    print(
        "Authentication    : ML-DSA-65"
    )

    print(
        "KDF               : HKDF-SHA256"
    )

    print(
        "Encryption        : AES-256-GCM"
    )

    print(
        "Server Identity   : PINNED"
    )

    print("=" * 60)

    return session_key


# =========================================================
# MAIN
# =========================================================

def main():

    tun = None
    sock = None

    try:

        # -------------------------------------------------
        # Create TUN interface
        # -------------------------------------------------

        tun = TunInterface(
            TUN_NAME
        )

        tun.create()

        print(
            f"[+] TUN interface: {tun.name}"
        )

        # -------------------------------------------------
        # Configure TUN IP address
        # -------------------------------------------------

        print(
            f"[*] Configuring {tun.name} "
            f"with {TUN_IP}/24"
        )

        result = os.system(
            f"ip addr replace "
            f"{TUN_IP}/24 "
            f"dev {tun.name}"
        )

        if result != 0:

            raise RuntimeError(
                "Failed to configure TUN IP address"
            )

        # -------------------------------------------------
        # Bring TUN interface UP
        # -------------------------------------------------

        result = os.system(
            f"ip link set "
            f"{tun.name} up"
        )

        if result != 0:

            raise RuntimeError(
                "Failed to bring TUN interface up"
            )

        print(
            f"[+] {tun.name} configured: "
            f"{TUN_IP}/24"
        )

        # -------------------------------------------------
        # AUTOMATIC VPN DEFAULT ROUTE
        # -------------------------------------------------
        #
        # All traffic that does not have a more specific
        # route will now be sent through tun0.
        #
        # This replaces the manual command:
        #
        # ip route replace default dev tun0
        #
        # The existing 192.168.100.0/24 route remains
        # more specific and therefore continues to be
        # used for communication with the VPN server.
        # -------------------------------------------------

        print(
            f"[*] Configuring default route via "
            f"{tun.name}..."
        )

        result = os.system(
            f"ip route replace default dev {tun.name}"
        )

        if result != 0:

            raise RuntimeError(
                "Failed to configure VPN default route"
            )

        print(
            f"[+] Default route configured via "
            f"{tun.name}"
        )

        # -------------------------------------------------
        # Create TCP socket
        # -------------------------------------------------

        sock = socket.socket(
            socket.AF_INET,
            socket.SOCK_STREAM
        )

        sock.setsockopt(
            socket.SOL_SOCKET,
            socket.SO_REUSEADDR,
            1
        )

        print()

        print(
            f"[*] Connecting to "
            f"{SERVER_IP}:{SERVER_PORT}"
        )

        # -------------------------------------------------
        # Connect to VPN server
        # -------------------------------------------------

        sock.connect(
            (
                SERVER_IP,
                SERVER_PORT
            )
        )

        print(
            "[+] Connected to VPN server"
        )

        # -------------------------------------------------
        # Perform quantum-safe handshake
        # -------------------------------------------------

        session_key = perform_handshake(
            sock
        )

        # -------------------------------------------------
        # Start packet forwarding threads
        # -------------------------------------------------

        thread1 = threading.Thread(
            target=tun_to_network,
            args=(
                tun,
                sock,
                session_key
            ),
            daemon=True
        )

        thread2 = threading.Thread(
            target=network_to_tun,
            args=(
                tun,
                sock,
                session_key
            ),
            daemon=True
        )

        thread1.start()
        thread2.start()

        print()
        print(
            "[+] QuantumSafeVPN client is running"
        )

        print(
            "[+] Internet traffic is routed "
            "through the VPN"
        )

        print(
            "[+] Press Ctrl+C to stop"
        )

        # -------------------------------------------------
        # Keep main thread alive
        # -------------------------------------------------

        while True:

            thread1.join(
                timeout=1
            )

            thread2.join(
                timeout=1
            )

    except KeyboardInterrupt:

        print()
        print(
            "[*] Stopping QuantumSafeVPN client..."
        )

    except Exception as e:

        print()
        print(
            f"[!] VPN client error: {e}"
        )

    finally:

        if sock is not None:

            try:
                sock.close()
            except Exception:
                pass

        if tun is not None:

            try:
                tun.close()
            except Exception:
                pass

        print(
            "[+] QuantumSafeVPN client stopped"
        )


# =========================================================
# PROGRAM ENTRY POINT
# =========================================================

if __name__ == "__main__":

    main()
