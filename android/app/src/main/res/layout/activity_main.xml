<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E1A"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QuantumSafeVPN"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Post-Quantum Secure Network Tunnel"
        android:textColor="#9CA3AF"
        android:textSize="13sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ML-KEM-1024"
            android:background="#1E293B"
            android:textColor="#38BDF8"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ML-DSA-65"
            android:background="#1E293B"
            android:textColor="#A855F7"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AES-256-GCM"
            android:background="#1E293B"
            android:textColor="#4ADE80"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editServerHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="VPN Server IP (e.g. 11.12.5.8)"
        android:text="11.12.5.8"
        android:textColor="#FFFFFF"
        android:textColorHint="#6B7280"
        android:background="#111827"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editServerPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Server Port (default 7000)"
        android:text="7000"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:textColorHint="#6B7280"
        android:background="#111827"
        android:padding="14dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnToggleVpn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CONNECT TO VPN"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtVpnStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected"
        android:textColor="#10B981"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Real-time Connection Log:"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050811"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtLogOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:text="QuantumSafeVPN Ready." />
    </ScrollView>

</LinearLayout>
